{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/academic_gate_hook.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
